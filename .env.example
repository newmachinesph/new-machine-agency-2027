# ── SMTP / email (contact form) ───────────────────────────────────────────
# Copy this file to `.env.local` and fill in your real mailbox credentials.
# The contact form's /api/contact route sends mail through this SMTP account.

SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@yourdomain.com
SMTP_PASS=your-mailbox-password

# From header on every outgoing email (must be a mailbox you're allowed to send as).
MAIL_FROM="New Machine <support@yourdomain.com>"

# Optional: where contact-form notifications are delivered.
# Defaults to `site.email` (hello@newmachine.ph) when unset.
# MAIL_TO=inbox@yourdomain.com

# ── Payload CMS ───────────────────────────────────────────────────────────
# keep Neon credentials secure: do not expose them to client-side code
DATABASE_URL='postgresql://user:password@host/db?sslmode=require'

# `openssl rand -hex 32` or any long random string
PAYLOAD_SECRET=

# Guards the seed routes, e.g. GET /api/seed-faq?token=<SEED_TOKEN>
SEED_TOKEN=

# One-shot seed routes (e.g. /api/seed-testimonials?token=...). Fail closed when unset.
SEED_TOKEN=

# Cloudflare R2 (S3-compatible) — server-only
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://<public-bucket>.r2.dev
